rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isValidUsername(value) {
      return value is string
        && value.size() >= 3
        && value.size() <= 24
        && value.matches('^[a-zA-Z0-9._-]+$');
    }

    function isValidTheme(value) {
      return value in ['light', 'dark'];
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isValidUsername(request.resource.data.username)
        && request.resource.data.usernameLower == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.passwordHash is string
        && request.resource.data.passwordSalt is string
        && isValidTheme(request.resource.data.themeMode);
      allow update: if isValidUsername(resource.data.username)
        && request.resource.data.username == resource.data.username
        && request.resource.data.usernameLower == resource.data.usernameLower
        && request.resource.data.passwordHash == resource.data.passwordHash
        && request.resource.data.passwordSalt == resource.data.passwordSalt
        && isValidTheme(request.resource.data.themeMode);
      allow delete: if false;
    }

    match /notes/{noteId} {
      allow read, create, update, delete: if true;
    }

    match /dailyTasks/{taskId} {
      allow read, create, update, delete: if true;
    }
  }
}
